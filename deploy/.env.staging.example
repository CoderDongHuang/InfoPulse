ENVIRONMENT=staging
APP_VERSION=staging
DATABASE_URL=postgresql+asyncpg://infopulse:staging-only-password@postgres:5432/infopulse
REDIS_URL=redis://redis:6379/0
AUTO_CREATE_TABLES=false
JWT_SECRET_KEY=staging-only-jwt-secret-change-before-shared-use
SSO_PROXY_SECRET=staging-only-sso-proxy-secret-change-me-now
PLATFORM_ENCRYPTION_KEY=staging-only-platform-encryption-change-me-now
METRICS_TOKEN=staging-only-metrics-token-change-me
ADMIN_EMAILS=["admin@example.com"]
CORS_ORIGINS=["http://localhost:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
TASK_SCHEDULER_ENABLED=true
RUN_BACKGROUND_WORKERS_IN_API=false
KNOWLEDGE_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=infopulse-knowledge
S3_ACCESS_KEY=staging-access
S3_SECRET_KEY=staging-secret-change-me
LLM_API_KEY=
SMTP_HOST=
SMTP_FROM=
