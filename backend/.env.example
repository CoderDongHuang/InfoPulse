# ============================================================
# InfoPulse — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://infopulse:infopulse@localhost:5432/infopulse
AUTO_CREATE_TABLES=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (OpenAI-compatible API) ---
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Crawler ---
CRAWLER_HEADLESS=true
CRAWLER_REQUEST_INTERVAL_MIN=2
CRAWLER_REQUEST_INTERVAL_MAX=5
BROWSER_RESTART_MB=800

# 微博 Cookie（可选，提升搜索稳定性）
WEIBO_COOKIE=

# 百度贴吧 Cookie（可选，提升搜索稳定性）
TIEBA_COOKIE=

# --- Demo Mode ---
DEMO_MODE=false
CRAWLER_ENABLED=true
# --- Runtime and public boundary ---
ENVIRONMENT=development
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
ADMIN_EMAILS=[]
METRICS_TOKEN=
DATA_RETENTION_DAYS=365
SLOW_QUERY_MS=500
