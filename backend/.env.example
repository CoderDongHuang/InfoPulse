# ============================================================
# InfoPulse — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://infopulse:infopulse@localhost:5432/infopulse

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (OpenAI-compatible API) ---
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Crawler ---
CRAWLER_HEADLESS=true
CRAWLER_REQUEST_INTERVAL_MIN=2
CRAWLER_REQUEST_INTERVAL_MAX=5
BROWSER_RESTART_MB=800

# --- Demo Mode ---
DEMO_MODE=false
CRAWLER_ENABLED=true
