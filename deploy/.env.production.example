INFOPULSE_IMAGE=ghcr.io/codexdonghuang/infopulse:VERSION
INFOPULSE_FRONTEND_IMAGE=ghcr.io/codexdonghuang/infopulse-web:VERSION
INFOPULSE_CANARY_IMAGE=ghcr.io/codexdonghuang/infopulse:VERSION
PUBLIC_HOST=app.example.com
API_HOST=api.example.com
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POSTGRES_HOST:5432/infopulse
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379/0
S3_ENDPOINT_URL=https://s3.example.com
S3_BUCKET=infopulse-knowledge
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_IN_SECRET_MANAGER
S3_SECRET_KEY=REPLACE_IN_SECRET_MANAGER
JWT_SECRET_KEY=REPLACE_WITH_48_RANDOM_CHARACTERS
SSO_PROXY_SECRET=REPLACE_WITH_48_RANDOM_CHARACTERS
PLATFORM_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_48_RANDOM_CHARACTERS
METRICS_TOKEN=REPLACE_WITH_32_RANDOM_CHARACTERS
ADMIN_EMAILS=["admin@example.com"]
CORS_ORIGINS=["https://app.example.com"]
TRUSTED_HOSTS=["api.example.com","app.example.com"]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_IN_SECRET_MANAGER
SMTP_PASSWORD=REPLACE_IN_SECRET_MANAGER
SMTP_FROM=InfoPulse <noreply@example.com>
LLM_API_KEY=REPLACE_IN_SECRET_MANAGER
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=REPLACE_WITH_APPROVED_MODEL
GITHUB_TOKEN=REPLACE_IN_SECRET_MANAGER
